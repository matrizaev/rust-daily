{
  "name": "rust-daily",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "content:check": "node scripts/validate-content.mjs",
    "content:check-refs": "node scripts/curriculum/check-content-refs.mjs",
    "content:generate": "node scripts/curriculum/generate-frontend-content.mjs",
    "content:curriculum-modules:test": "node scripts/curriculum/test-curriculum-modules.mjs",
    "content:scaffold-lesson": "node scripts/curriculum/scaffold-lesson.mjs",
    "content:scaffold-lesson:test": "node scripts/curriculum/test-scaffold-lesson.mjs",
    "content:shared:test": "node scripts/curriculum/test-shared-helpers.mjs",
    "content:validate-source:test": "node scripts/curriculum/test-validate-source-content.mjs",
    "content:validate-source": "node scripts/curriculum/validate-source-content.mjs",
    "coverage": "vitest run --coverage",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}